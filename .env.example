DATABASE_URL=sqlite:///./data/promptpop.db
APP_ENV=development
SERVE_FRONTEND=true
STORAGE_DIR=./data/assets
ASSET_STORAGE=local
# Cloud free plan: ASSET_STORAGE=supabase and DATABASE_SCHEMA=promptpop.
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and SUPABASE_BUCKET stay server-only.
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SESSION_HOURS=12
# Cloud configuration and bootstrap are documented in docs/DEPLOYMENT.md.
# Never copy a production secret into a VITE_ variable.
# Optional authorized vision evaluator. Disabled when empty.
EVALUATOR_URL=
EVALUATOR_SECRET=
